# customers.riskmandate.ai: what never enters the tree
# (the committed tree is the deployed tree, so this list is short on purpose;
#  a generic Python ignore of `build/` would hide admin/build/, so none is used)

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/
_site/
.DS_Store

# the credentials tier: keys, tokens and lists of people live here and are never committed
credentials/
